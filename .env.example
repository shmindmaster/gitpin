# Local stdio and snapshot commands
GITPIN_REGISTRY=registry/repositories.yaml
GITPIN_INDEX_PATH=.repocontext-index

# Authenticated HTTP transport
# Generate a strong value in your secret manager before starting the HTTP server.
GITPIN_MCP_TOKEN=
GITPIN_ALLOWED_HOSTS=localhost
# Browser origins allowed to call /api/mcp, comma-separated (scheme://host[:port]).
# Loopback origins are always allowed; requests without Origin are unaffected.
GITPIN_ALLOWED_ORIGINS=
# Loopback by default. A non-loopback HOST such as 0.0.0.0 requires GITPIN_ALLOWED_HOSTS.
HOST=127.0.0.1
PORT=3000

# Remote smoke verification
GITPIN_MCP_URL=http://localhost:3000/api/mcp

# Optional static-site analytics. This is a public project key, not a secret.
# Leave blank to produce a telemetry-free website build.
POSTHOG_GITPIN_PROJECT_KEY=
