{
  "schemaVersion": 1,
  "summary": "Harden the self-hosted HTTP MCP transport: bind loopback by default, refuse a public bind without a host allowlist, and reject foreign browser Origins (DNS rebinding).",
  "claims": [
    {
      "id": "HTTP-LOOPBACK-DEFAULT",
      "statement": "src/http.ts resolveHttpBindOptions defaults HOST to 127.0.0.1 and refuses a non-loopback bind without GITPIN_ALLOWED_HOSTS; isLoopbackHost accepts 127.0.0.0/8 and every IPv6 loopback spelling; Dockerfile.remote sets HOST=0.0.0.0 for the container, .env.example binds loopback, and src/http.test.ts asserts the default, the refusal and the loopback spellings.",
      "covers": [
