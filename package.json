{
  "name": "gitpin",
  "version": "0.5.2",
  "mcpName": "io.github.shmindmaster/gitpin",
  "type": "commonjs",
  "description": "Prove and verify multi-repo agent claims at Git HEAD—index-free evidence packs with path, line, and full SHA.",
  "author": "Sarosh Hussain",
  "license": "MIT",
  "homepage": "https://shmindmaster.github.io/gitpin/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shmindmaster/gitpin.git"
  },
  "bugs": {
    "url": "https://github.com/shmindmaster/gitpin/issues"
  },
  "bin": {
    "gitpin": "dist/server.js",
    "repocontext": "dist/server.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    ".env.example",
    "templates/wiki.yaml",
    "templates/gitpin-skill.md",
    "templates/client-rules.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "ROADMAP.md",
    "SECURITY.md",
    "server.json",
    "docs",
    "docs/migration-gitpin.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mcp:serve": "tsx src/server.ts",
    "mcp:http": "tsx src/http.ts",
    "doctor:check": "tsx src/server.ts doctor",
    "index:build": "tsx src/snapshot.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:container": "node scripts/verify-container.mjs",
    "verify:remote": "node scripts/verify-remote.mjs",
    "start": "node dist/http.js",
    "lint": "biome lint src scripts site/app.js site/analytics.js tests playwright.config.mjs",
    "format": "biome format --write src scripts site/app.js site/analytics.js tests playwright.config.mjs package.json tsconfig.json biome.json",
    "format:check": "biome format src scripts site/app.js site/analytics.js tests playwright.config.mjs package.json tsconfig.json biome.json",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run src",
    "verify:clients": "node scripts/validate-client-configs.mjs",
    "verify:ci": "node scripts/verify-ci-runner-routing.mjs",
    "verify:env": "node scripts/validate-env-example.mjs",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "verify:mcp-registry": "node scripts/verify-mcp-registry.mjs",
    "verify:citations": "node scripts/verify-citations.mjs",
    "demo:reset": "node scripts/demo-fixture.mjs",
    "demo:workflow": "pnpm build && node scripts/demo-workflow.mjs",
    "demo:verify": "pnpm build && node scripts/verify-demo-workflow.mjs",
    "demo:present": "pnpm build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/demo-terminal.ps1",
    "demo:record": "pnpm build && node scripts/record-demo.mjs",
    "demo:record:qwen": "pnpm build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/record-demo-qwen.ps1",
    "site:serve": "node scripts/serve-site.mjs site",
    "site:build": "node scripts/build-site.mjs",
    "site:test": "playwright test",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm verify:clients && pnpm verify:ci && pnpm verify:env && pnpm verify:mcp-registry && pnpm verify:release-tag && pnpm test && pnpm site:build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "simple-git": "^3.27.0",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "git",
    "commit-pinned",
    "read-only",
    "coding-agents",
    "provenance",
    "claude-code",
    "codex",
    "cursor"
  ]
}
