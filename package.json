{
  "name": "repocontext",
  "version": "0.1.0",
  "private": false,
  "description": "MCP server that gives AI agents safe, searchable, commit-pinned context across your entire multi-repo codebase.",
  "license": "MIT",
  "packageManager": "pnpm@11.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "mcp:serve": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src/",
    "validate": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "simple-git": "^3.27.0",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "vitest": "^3.1.0",
    "@types/node": "^22.0.0"
  },
  "keywords": ["mcp", "ai-agents", "codebase", "multi-repo", "documentation", "context", "claude", "codex", "cursor", "model-context-protocol"]
}
