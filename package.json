{
  "name": "repocontext",
  "version": "0.2.0",
  "type": "commonjs",
  "description": "Give coding agents fast, commit-pinned context across the repositories that matter.",
  "author": "Sarosh Hussain",
  "license": "MIT",
  "homepage": "https://github.com/shmindmaster/repocontext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shmindmaster/repocontext.git"
  },
  "bugs": {
    "url": "https://github.com/shmindmaster/repocontext/issues"
  },
  "bin": {
    "repocontext": "dist/server.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "templates/wiki.yaml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mcp:serve": "tsx src/server.ts",
    "mcp:http": "tsx src/http.ts",
    "doctor:check": "tsx src/server.ts doctor",
    "index:build": "tsx src/snapshot.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:remote": "node scripts/verify-remote.mjs",
    "start": "node dist/http.js",
    "lint": "biome lint src scripts site/app.js site/analytics.js tests playwright.config.mjs",
    "format": "biome format --write src scripts site/app.js site/analytics.js tests playwright.config.mjs package.json tsconfig.json biome.json",
    "format:check": "biome format src scripts site/app.js site/analytics.js tests playwright.config.mjs package.json tsconfig.json biome.json",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run src",
    "verify:clients": "node scripts/validate-client-configs.mjs",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "site:serve": "node scripts/serve-site.mjs site",
    "site:build": "node scripts/build-site.mjs",
    "site:test": "playwright test",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm verify:clients && pnpm test && pnpm site:build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "simple-git": "^3.27.0",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agents",
    "coding-agents",
    "codebase-context",
    "repository-search",
    "developer-tools",
    "claude-code",
    "codex",
    "cursor"
  ]
}
